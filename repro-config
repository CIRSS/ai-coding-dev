
NODE_VERSION=22.11.0

REPRO_NAME=ai-coding-dev
REPRO_DOCKER_ORG=cirss
REPRO_IMAGE_TAG=latest

PARENT_BUILD_ARG_1=${NODE_VERSION}
PARENT_IMAGE=${REPRO_DOCKER_ORG}/${REPRO_NAME}-parent:latest

DOCKER_BUILD_PROGRESS=plain

# Carry the host's git identity in as the reviewer. A container has no git
# identity of its own, and who reviewed a file is a fact about the person at
# the keyboard, not about the image.
REPRO_DOCKER_OPTIONS = --env REVIEWS_BY="$(shell git config user.name)"

image:                  build-image   ## Build this REPRO's image.
start:                  start-repro   ## Start an interactive session in this REPRO.

update-reviews:         build-reports ## Rewrite REVIEW.md, then show who has reviewed what.

## reviews:                              Run reviews itself. Prefer ./reviews, which takes its arguments directly.
ARGS ?=
.PHONY: reviews
reviews: session
	$(RUN_IN_REPRO) 'reviews $(ARGS)'

##
